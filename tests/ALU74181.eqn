#define P_BAR(a, b) (!((!(b) & S_1) | (S_0 & (b)) | (a)))
#define G_BAR(a, b) (!(((b) & S_3 & (a)) | ((a) & S_2 & !(b))))
#define xor(a, b) (!(a) & (b) | (a) & !(b))
#define PS(a, b) xor(P_BAR((a), (b)), G_BAR((a), (b)))
NAME = ALU74181;
INORDER = M S_3 S_2 S_1 S_0 B_3 B_2 B_1 B_0 A_3 A_2 A_1 A_0 C_N_BAR;
OUTORDER = C_N_PLUS_4_BAR F_3 F_2 F_1 F_0 EQUAL Y X;
C_N_PLUS_4_BAR = !Y | (!X & C_N_BAR);
EQUAL = F_3 & F_2 & F_1 & F_0;
X = !(G_BAR(A_3, B_3) & G_BAR(A_2, B_2) & G_BAR(A_1, B_1) & G_BAR(A_0, B_0));
Y = !(P_BAR(A_3, B_3)
        | (G_BAR(A_3, B_3) & P_BAR(A_2, B_2))
        | (G_BAR(A_3, B_3) & G_BAR(A_2, B_2) & P_BAR(A_1, B_1))
        | (G_BAR(A_3, B_3) & G_BAR(A_2, B_2) & G_BAR(A_1, B_1) & P_BAR(A_0, B_0)));
F_0 = xor(PS(A_0, B_0), (!(C_N_BAR & !M)));
F_1 = xor(PS(A_1, B_1), (!((C_N_BAR & G_BAR(A_0, B_0) & !M) | (P_BAR(A_0, B_0) & !M))));
F_2 = xor(PS(A_2, B_2),
            (!(
                (C_N_BAR & G_BAR(A_0, B_0) & G_BAR(A_1, B_1) & !M)
                | (G_BAR(A_1, B_1) & P_BAR(A_0, B_0) & !M)
                | (P_BAR(A_1, B_1) & !M)
               ))
          );
F_3 = xor(PS(A_3, B_3),
            (!(
                (C_N_BAR & G_BAR(A_0, B_0) & G_BAR(A_1, B_1) & G_BAR(A_2, B_2) & !M)
                | (G_BAR(A_1, B_1) & G_BAR(A_2, B_2) & P_BAR(A_0, B_0) & !M)
                | (G_BAR(A_2, B_2) & P_BAR(A_1, B_1) & !M)
                | (P_BAR(A_2, B_2) & !M)
               ))
          );
